    }

    function installFsUi() {
        if (typeof document === "undefined") return;
        loadFsFlags();
        ensureFsStyle();
        bindFsListeners();
        if (!document.body) {
            document.addEventListener("DOMContentLoaded", syncFsChrome);
            return;
        }
        syncFsChrome();
    }

    function boot() {
        if (typeof document === "undefined") return 0;
        installFsUi();
        hideOverlayFileInput();
        dropLayer();
        patchPause();
