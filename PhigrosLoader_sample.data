    function hideFsOverlays() {
        var gate = document.getElementById("pls-gx-fs-gate");
        if (gate) gate.style.display = "none";
        var chip = document.getElementById("pls-gx-fs-chip");
        if (chip) chip.style.display = "none";
    }

    function dismissFsGate() {
        var gate = document.getElementById("pls-gx-fs-gate");
        if (gate && gate.parentNode) gate.parentNode.removeChild(gate);
        relayoutGame();
        setTimeout(relayoutGame, 120);
        setTimeout(relayoutGame, 400);
        syncFsChrome();
    }

    function enterFullscreenPlay() {
        markFsWanted();
        markFsGateDone();
        requestPageFullscreen().then(function () {
            lockLandscape();
            dismissFsGate();
        });
    }

    function reenterFullscreenSoon() {
        if (!fsWanted || fsPicking || dropLayerOpen) {
            syncFsChrome();
            return;
        }
        requestPageFullscreen().then(function (ok) {
            if (ok) lockLandscape();
            relayoutGame();
            syncFsChrome();
        });
        setTimeout(function () {
            if (fsWanted && !isPageFullscreen()) syncFsChrome();
        }, 350);
    }

    function syncRotateHint() {
        if (typeof document === "undefined") return;
        var hint = document.getElementById("pls-gx-rotate-hint");
        if (!isPortraitView() || document.getElementById("pls-gx-fs-gate") || dropLayerOpen) {
            if (hint) hint.style.display = "none";
            return;
        }
        if (!hint) {
            hint = document.createElement("div");
            hint.id = "pls-gx-rotate-hint";
            hint.lang = "en-US";
            hint.textContent = "Rotate to landscape";
            hint.style.cssText = "position:fixed;left:0;right:0;top:0;z-index:2147483643;background:#bdff00;color:#111;text-align:center;padding:10px 12px;font:600 15px/1.3 arial,sans-serif;";
            (document.body || document.documentElement).appendChild(hint);
        }
        hint.style.display = "block";
    }

    function ensureFsStyle() {
        if (document.getElementById("pls-gx-fs-style")) return;
        var st = document.createElement("style");
        st.id = "pls-gx-fs-style";
        st.textContent = "html,body{margin:0;background:#060612;overflow:hidden;height:100%;height:100dvh}#pls-gx-fs-gate{position:fixed;inset:0;z-index:2147483646;background:#060612;color:#eee;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:arial,sans-serif;text-align:center;padding:24px;-webkit-tap-highlight-color:transparent}#pls-gx-fs-gate p{opacity:.85;margin:0 0 22px;line-height:1.55;font-size:1.02rem}#pls-gx-fs-gate b{display:inline-block;background:#bdff00;color:#111;border-radius:12px;padding:14px 28px;font-size:1.05rem}#pls-gx-fs-chip{position:fixed;right:12px;bottom:12px;z-index:2147483644;background:#bdff00;color:#111;border:0;border-radius:10px;padding:10px 14px;font:700 14px arial,sans-serif;cursor:pointer;-webkit-tap-highlight-color:transparent}";
        (document.head || document.documentElement).appendChild(st);
